{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["public/**"],
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "varsIgnorePattern": "^_",
        "argsIgnorePattern": "^_",
        "fix": {
          "imports": "safe-fix",
          "variables": "suggestion"
        }
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "inline-type-imports"
      }
    ]
  },
  "env": {
    "builtin": true
  }
}
