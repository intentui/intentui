{
  "name": "intentui",
  "author": "irsyadadl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "first-time": "npm install && npm run build && next dev",
    "lint": "biome check",
    "build:stubs": "rm -rf public/stubs && node --import tsx src/scripts/build-stubs.ts",
    "build:llms": "node --import tsx src/scripts/generate-llms.ts",
    "build:search": "node --import tsx src/scripts/generate-search.ts",
    "prebuild": "npx fumadocs-mdx && npm run build:search && npm run build:llms && npm run registry:generate && node --import tsx src/scripts/extract-components-from-registry.ts && npm run build:stubs",
    "cuc": "node --import tsx src/scripts/check-use-client.ts",
    "cdc": "node --import tsx src/scripts/check-duplicated-classes.ts",
    "registry:generate": "node --import tsx src/scripts/generate-registry.ts && npx shadcn build && node --import tsx src/scripts/cleanup-staged.ts",
    "r": "npm run registry:generate",
    "dev": "next dev --turbopack",
    "build": "_FUMADOCS_MDX=1 next build --webpack",
    "format": "biome lint --fix && biome check --write",
    "format:unsafe": "biome check --unsafe --write",
    "start": "next start",
    "preview": "npm run build && next start",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": [
      "biome lint --fix && biome check --write"
    ]
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@intentui/icons": "^1.11.0",
    "@shikijs/rehype": "^3.21.0",
    "@shikijs/transformers": "^3.21.0",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "@wandry/analytics-sdk": "^1.16.0",
    "culori": "^4.0.2",
    "dayjs": "^1.11.19",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-core": "^16.4.6",
    "fumadocs-mdx": "^14.2.4",
    "input-otp": "^1.4.2",
    "motion": "^12.25.0",
    "next": "^16.1.1",
    "next-themes": "^0.4.6",
    "ntcjs": "^1.1.3",
    "react": "^19.2.3",
    "react-aria-components": "^1.14.0",
    "react-dom": "^19.2.3",
    "react-intersection-observer": "^10.0.0",
    "react-resizable-panels": "^4.4.0",
    "recharts": "^3.6.0",
    "rehype-stringify": "^10.0.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "shadcn": "^3.6.3",
    "sharp": "^0.34.5",
    "shiki": "^3.21.0",
    "sonner": "^2.0.7",
    "tailwind-variants": "^3.2.2",
    "tailwindcss-react-aria-components": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.1.0",
    "usemods": "^1.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@types/culori": "^4.0.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.0.6",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.9.14",
    "encoding": "^0.1.13",
    "postcss": "^8.5.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "shadcn": {
      "zod": "3.25.76"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentui/intentui.git"
  },
  "trustedDependencies": [
    "es5-ext",
    "esbuild",
    "sharp"
  ]
}
