{
  "name": "intentui",
  "author": "irsyadadl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "first-time": "bun i && bun run build && next dev",
    "lint": "biome check",
    "build:stubs": "rm -rf public/stubs && bun run src/scripts/build-stubs.ts",
    "build:llms": "bun run src/scripts/generate-llms.ts",
    "build:search": "bun run src/scripts/generate-search.ts",
    "prebuild": "bun run build:search && bun run build:llms && bun run build:registry && bun run build:stubs",
    "cuc": "bun run src/scripts/check-use-client.ts",
    "cdc": "bun run src/scripts/check-duplicated-classes.ts",
    "prepare": "husky",
    "build:old-registry": "rm -rf public/registry && bun run src/scripts/build-old-registry.ts",
    "build:registry": "bun run src/scripts/build-registry.ts && npx shadcn build && bun run src/scripts/extract-components-from-registry.ts",
    "dev": "next dev --turbopack",
    "build": "next build",
    "format": "biome lint --fix && biome check --write",
    "format:unsafe": "biome check --unsafe --write",
    "build:everything": "rm -rf public/registry && bun run build:registry && bun run build:search && bun run build:stubs",
    "bb": "bun run format && bun run build:everything",
    "start": "next start",
    "preview": "bun run build && next start",
    "ic": "bun run src/scripts/identify-color.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "husky"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": ["biome lint --fix && biome check --write"]
  },
  "dependencies": {
    "@intentui/icons": "^1.11.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@shikijs/rehype": "^3.12.2",
    "@shikijs/transformers": "^3.12.2",
    "culori": "^4.0.2",
    "dayjs": "^1.11.18",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-mdx": "11.6.1",
    "input-otp": "^1.4.2",
    "motion": "^12.23.12",
    "next": "^15.5.2",
    "next-themes": "^0.4.6",
    "ntcjs": "^1.1.3",
    "react": "^19.1.1",
    "react-aria-components": "^1.12.1",
    "react-dom": "^19.1.1",
    "react-intersection-observer": "^9.16.0",
    "react-resizable-panels": "^3.0.5",
    "recharts": "^3.1.2",
    "rehype-stringify": "^10.0.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "shadcn": "^2.10.0",
    "sharp": "^0.34.3",
    "shiki": "^3.12.2",
    "sonner": "^2.0.7",
    "tailwind-variants": "^3.1.0",
    "tailwindcss-react-aria-components": "^2.0.1",
    "tw-animate-css": "^1.3.8",
    "use-debounce": "^10.0.6",
    "usemods": "^1.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.3",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "19.8.0",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bun": "^1.2.21",
    "@types/culori": "^4.0.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/title": "^4.0.0",
    "babel-plugin-react-compiler": "^19.0.0-beta-ebf51a3-20250411",
    "cz-conventional-changelog": "^3.3.0",
    "encoding": "^0.1.13",
    "husky": "^9.1.7",
    "postcss": "^8.5.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irsyadadl/intentui.git"
  },
  "trustedDependencies": ["es5-ext", "esbuild", "sharp"],
  "overrides": {
    "react-is": "^19.0.0"
  }
}
