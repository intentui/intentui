{
  "name": "intentui",
  "author": "irsyadadl",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "first-time": "bun i && bun run build && next dev",
    "lint": "biome check",
    "build:stubs": "rm -rf public/stubs && bun run src/scripts/build-stubs.ts",
    "build:llms": "bun run src/scripts/generate-llms.ts",
    "build:search": "bun run src/scripts/generate-search.ts",
    "prebuild": "bun run build:search && bun run build:llms && bun run registry:generate && bun run src/scripts/extract-components-from-registry.ts && bun run build:stubs",
    "cuc": "bun run src/scripts/check-use-client.ts",
    "cdc": "bun run src/scripts/check-duplicated-classes.ts",
    "registry:generate": "bun run src/scripts/generate-registry.ts && bun run shadcn build && bun run src/scripts/cleanup-staged.ts",
    "r": "bun run registry:generate",
    "dev": "next dev --turbopack",
    "build": "next build",
    "format": "biome lint --fix && biome check --write",
    "format:unsafe": "biome check --unsafe --write",
    "start": "next start",
    "preview": "bun run build && next start",
    "ic": "bun run src/scripts/identify-color.ts",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "./**/*.{ts,tsx}": ["biome lint --fix && biome check --write"]
  },
  "dependencies": {
    "@intentui/icons": "^1.11.0",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@shikijs/rehype": "^3.13.0",
    "@shikijs/transformers": "^3.13.0",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "dayjs": "^1.11.18",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fumadocs-mdx": "11.6.3",
    "input-otp": "^1.4.2",
    "motion": "^12.23.22",
    "next": "^15.5.4",
    "next-themes": "^0.4.6",
    "ntcjs": "^1.1.3",
    "react": "^19.2.0",
    "react-aria-components": "^1.13.0",
    "react-dom": "^19.2.0",
    "react-intersection-observer": "^9.16.0",
    "react-resizable-panels": "^3.0.6",
    "recharts": "^3.2.1",
    "rehype-stringify": "^10.0.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "shadcn": "^3.3.1",
    "sharp": "^0.34.4",
    "shiki": "^3.13.0",
    "sonner": "^2.0.7",
    "tailwind-variants": "^3.1.1",
    "tailwindcss-react-aria-components": "^2.0.1",
    "tw-animate-css": "^1.4.0",
    "use-debounce": "^10.0.6",
    "usemods": "^1.15.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "^1.2.23",
    "@types/culori": "^4.0.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/title": "^4.0.0",
    "encoding": "^0.1.13",
    "postcss": "^8.5.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irsyadadl/intentui.git"
  },
  "trustedDependencies": ["es5-ext", "esbuild", "sharp"],
  "overrides": {
    "react-is": "^19.0.0"
  }
}
