    {
      "name": "components/navbar/app-navbar.tsx.stub",
      "content": "import { ThemeSwitcher } from \"@/components/theme-switcher\"\nimport {\n  IconBrandApple,\n  IconCommandRegular,\n  IconDashboard,\n  IconHeadphones,\n  IconLogout,\n  IconSearch,\n  IconSettings,\n  IconShield,\n  IconShoppingBag,\n} from \"@intentui/icons\"\nimport { Avatar} from \"@/components/ui/avatar\"\nimport { Menu} from \"@/components/ui/menu\"\nimport { Separator} from \"@/components/ui/separator\"\nimport { Navbar} from \"@/components/ui/navbar\"\nimport { Button} from \"@/components/ui/button\"\n\nexport default function AppNavbar() {\n  return (\n    <Navbar>\n      <Navbar.Nav>\n        <Navbar.Logo href=\"/docs/components/layouts/navbar\">\n          <IconBrandApple className=\"size-6 lg:size-5\" />\n        </Navbar.Logo>\n        <Navbar.Section>\n          <Navbar.Item isCurrent href=\"#\">\n            Home\n          </Navbar.Item>\n          <Navbar.Item href=\"#\">Mac</Navbar.Item>\n          <Navbar.Item href=\"#\">iPad</Navbar.Item>\n        </Navbar.Section>\n        <Navbar.Section className=\"hidden ml-auto lg:flex\">\n          <Navbar.Flex>\n            <Button intent=\"plain\" size=\"sq-sm\" aria-label=\"Search for products\">\n              <IconSearch />\n            </Button>\n            <Button intent=\"plain\" size=\"sq-sm\" aria-label=\"Your Bag\">\n              <IconShoppingBag />\n            </Button>\n            <ThemeSwitcher intent=\"plain\" />\n          </Navbar.Flex>\n          <Separator orientation=\"vertical\" className=\"mr-3 ml-1 h-6\" />\n          <UserMenu />\n        </Navbar.Section>\n      </Navbar.Nav>\n\n      <Navbar.Compact>\n        <Navbar.Flex>\n          <Navbar.Trigger className=\"-ml-2\" />\n          <Separator orientation=\"vertical\" className=\"h-6 lg:mx-1\" />\n          <Navbar.Logo href=\"/docs/components/layouts/navbar\">\n            <IconBrandApple className=\"size-5\" />\n          </Navbar.Logo>\n        </Navbar.Flex>\n        <Navbar.Flex>\n          <Navbar.Flex>\n            <Button intent=\"plain\" size=\"sq-sm\" aria-label=\"Search for products\">\n              <IconSearch />\n            </Button>\n            <Button intent=\"plain\" size=\"sq-sm\" aria-label=\"Your Bag\">\n              <IconShoppingBag />\n            </Button>\n            <ThemeSwitcher intent=\"plain\" />\n          </Navbar.Flex>\n          <Separator orientation=\"vertical\" className=\"mr-3 ml-1 h-6\" />\n          <UserMenu />\n        </Navbar.Flex>\n      </Navbar.Compact>\n    </Navbar>\n  )\n}\n\nfunction UserMenu() {\n  return (\n    <Menu>\n      <Menu.Trigger aria-label=\"Open Menu\">\n        <Avatar alt=\"cobain\" size=\"sm\" isCircle={false} src=\"/images/avatar/cobain.jpg\" />\n      </Menu.Trigger>\n      <Menu.Content placement=\"bottom right\" className=\"sm:min-w-56\">\n        <Menu.Section>\n          <Menu.Header separator>\n            <span className=\"block\">Kurt Cobain</span>\n            <span className=\"font-normal text-muted-fg\">@cobain</span>\n          </Menu.Header>\n        </Menu.Section>\n\n        <Menu.Item href=\"#dashboard\">\n          <IconDashboard />\n          Dashboard\n        </Menu.Item>\n        <Menu.Item href=\"#settings\">\n          <IconSettings />\n          Settings\n        </Menu.Item>\n        <Menu.Item href=\"#security\">\n          <IconShield />\n          Security\n        </Menu.Item>\n        <Menu.Separator />\n        <Menu.Item>\n          <IconCommandRegular />\n          Command Menu\n        </Menu.Item>\n\n        <Menu.Item href=\"#contact\">\n          <IconHeadphones />\n          Customer Support\n        </Menu.Item>\n        <Menu.Separator />\n        <Menu.Item href=\"#logout\">\n          <IconLogout />\n          Log out\n        </Menu.Item>\n      </Menu.Content>\n    </Menu>\n  )\n}\n"
    }
  ]
}